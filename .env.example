# Copy to .env for local use, or set these in your host's dashboard.
# Generate secrets with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

NODE_ENV=production

# Signs tickets and organizer sessions. 24+ characters. Changing it signs everyone out
# and invalidates every ticket already issued.
TICKET_SECRET=

# Who may create an organizer account. Set ONE of these:
#   SIGNUP_CODE         organizers must enter this code when they sign up (6+ characters)
#   ALLOW_PUBLIC_SIGNUP=true   anyone can sign up
SIGNUP_CODE=
ALLOW_PUBLIC_SIGNUP=

# Where the database and uploaded flyers are stored. On a host this MUST be a persistent disk.
DATA_DIR=/data

# Optional: lets organizers email themselves the event report. Any SMTP provider works.
SMTP_URL=
MAIL_FROM=

# Optional: Google Calendar (organizer date picker, one-tap add for attendees). See the README.
# Redirect address to register in Google Cloud: <PUBLIC_URL>/api/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
PUBLIC_URL=
# Set to false until Google has verified your app, if you do not want attendees to see the one-tap option.
GOOGLE_ATTENDEE_ADD=
